# Configuração do histórico via Databricks (não commitar o token real!)
# Copie para .env (ou exporte como variáveis de ambiente no run.py/start.bat)
DATABRICKS_HOST=dbc-xxxx.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/<warehouse_id>
DATABRICKS_TOKEN=dapi...
DATABRICKS_CATALOG=main
DATABRICKS_SCHEMA=gold
HISTORY_WINDOW_DAYS=3